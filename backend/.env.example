PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE_MB=50

# Database Configuration (Docker MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=nextjs_app
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Authentication & JWT Configuration
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Protects the HTML/JSON API explorer; set a unique username and password.
API_DOCS_USER=
API_DOCS_PASSWORD=

# Optional one-time first-admin bootstrap. Never use demo credentials.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Venice AI (optional; keep server-side only)
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_IMAGE_MODEL=fluently-xl

# Google AI Studio / Gemini (optional; keep server-side only)
GEMINI_API_KEY=

# OpenAI (optional; keep server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Stripe is optional until billing is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Image hosting — imgbb (https://api.imgbb.com/1/upload). This is the only
# host used for saving images; links come back as https://i.ibb.co/<id>.
# Get a key at https://api.imgbb.com/user/api_key  (server-side only: it must
# never be exposed to the browser, so it is only read by the backend).
IMGBB_API_KEY=

# Optional: seconds after which imgbb deletes the uploaded image (60-15552000).
# Leave blank or 0 to keep images permanently.
IMGBB_EXPIRATION=

# Optional: milliseconds to wait for an upload before reporting a timeout.
# Default 30000. The client queue and the server-side concurrency gate absorb
# imgbb's burst throttling (HTTP 429).
IMGBB_TIMEOUT_MS=30000

# Image hosting logs are written to backend/logs/hosting/hosting-YYYY-MM-DD.jsonl
# (one JSON line per attempt: source, timing, outcome, url or failure reason).
# Images are NEVER stored in the database. Set HOSTING_LOG_DB=1 only if you also
# want the log metadata mirrored into the image_hosting_logs table.
HOSTING_LOG_DB=0

# Only needed when your network drops outbound traffic (a corporate firewall or
# ISP block) but you have a VPN/HTTP proxy that can reach it. Node's fetch honours
# these vars; uncomment and point HTTPS_PROXY at the proxy's HTTP CONNECT port
# (e.g. http://127.0.0.1:7890 for Clash/v2rayN, http://127.0.0.1:10809 for a local
# client).
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890

# Public origin of this API, used to build shareable image URLs.
# Falls back to the incoming request host when unset.
PUBLIC_URL=

# PostHog analytics — project API key (phc_...) from Project Settings.
# Used by posthog.service.js for server-side $ai_generation events;
# falls back to the bundled project key when unset.
POSTHOG_KEY=
# Region host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU).
POSTHOG_HOST=https://us.i.posthog.com

# Personal API key (phx_...) for the SuperAdmin "PostHog Analytics" panel —
# needed to READ data back (the phc_ project key above can only ingest).
# Create in PostHog -> Settings -> Personal API keys with scopes:
#   query:read, feature_flag:read, feature_flag:write
POSTHOG_PERSONAL_API_KEY=
# PostHog project whose data the panel reads (SuperAdmin control center).
POSTHOG_PROJECT_ID=644102
# HTTP API host (NOT the SDK host). EU cloud: https://eu.posthog.com
POSTHOG_API_HOST=https://us.posthog.com

# Auth0 Management API (server-side only)
# Create a Machine-to-Machine application and authorize it for the Auth0
# Management API with only the scopes this backend actually needs.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# remove.bg background removal (server-side only).
# Protect provider spending by listing the authenticated account IDs allowed
# to use it. Requests are limited to 3 per IP per 15 minutes.
REMOVE_BG_API_KEY=
REMOVE_BG_ALLOWED_USER_IDS=
